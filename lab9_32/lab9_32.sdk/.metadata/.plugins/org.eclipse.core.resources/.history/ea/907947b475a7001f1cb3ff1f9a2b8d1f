#include <stdio.h>
#include <math.h>
#include <xparameters.h>
#include <xaxidma.h>
#include <xtime_l.h>

#define N 32 // 32-point FFT
#define PI 3.14159265358979323846

typedef struct {
    double real;
    double imag;
} Complex;

// PS-side FFT function
void fft(Complex *x) {
    unsigned int i, j, k, m;
    unsigned int n = N;
    unsigned int a, b;
    Complex temp, W;
    int logN = log2(N);

    // Bit reversal (reordering the input array)
    for (i = 1, j = 0; i < n; i++) {
        unsigned int bit = n >> 1;
        while (j >= bit) {
            j -= bit;
            bit >>= 1;
        }
        j += bit;

        if (i < j) {
            // Swap the values
            temp = x[i];
            x[i] = x[j];
            x[j] = temp;
        }
    }

    // FFT computation
    for (i = 1; i <= logN; i++) {
        m = 1 << i;  // m = 2, 4, 8, ..., N
        for (k = 0; k < n; k += m) {
            for (j = 0; j < m / 2; j++) {
                W.real = cos(-2 * PI * j / m);
                W.imag = sin(-2 * PI * j / m);

                a = k + j;
                b = k + j + m / 2;

                // Multiply W with x[b]
                temp.real = W.real * x[b].real - W.imag * x[b].imag;
                temp.imag = W.real * x[b].imag + W.imag * x[b].real;

                // Butterfly operation
                x[b].real = x[a].real - temp.real;
                x[b].imag = x[a].imag - temp.imag;

                x[a].real += temp.real;
                x[a].imag += temp.imag;
            }
        }
    }
}

// Print FFT output
void printFFT(Complex *x) {
    for (int i = 0; i < N; i++) {
        printf("X[%d]: %.5f + %.5fi\n", i, x[i].real, x[i].imag);
    }
}

// PL-side DMA transfer initialization
int DMA_Init(XAxiDma *AxiDMA, u16 DeviceId) {
    XAxiDma_Config *Config = XAxiDma_LookupConfig(DeviceId);
    if (!Config) {
        printf("No configuration found for %d\n", DeviceId);
        return XST_FAILURE;
    }

    int status = XAxiDma_CfgInitialize(AxiDMA, Config);
    if (status != XST_SUCCESS) {
        printf("Initialization failed %d\n", status);
        return XST_FAILURE;
    }

    // Ensure DMA is in simple mode
    if (!XAxiDma_HasSg(AxiDMA)) {
        return XST_SUCCESS;
    } else {
        printf("Device is in scatter-gather mode\n");
        return XST_FAILURE;
    }
}

int main() {
    // Input: 32-point array
    Complex x[N] = {
        {11, 23}, {32, 10}, {91, 94}, {15, 69}, {47, 96}, {44, 12}, {96, 17}, {49, 58},
        {8, 16}, {20, 13}, {72, 67}, {34, 18}, {99, 44}, {37, 56}, {80, 24}, {60, 70},
        {10, 30}, {23, 45}, {65, 33}, {19, 74}, {50, 26}, {71, 55}, {89, 41}, {28, 63},
        {7, 22}, {41, 36}, {93, 62}, {48, 12}, {55, 77}, {37, 11}, {22, 84}, {39, 47}
    };

    Complex x_pl[N]; // To hold PL output

    // Initialize DMA
    XAxiDma AxiDMA;
    int status = DMA_Init(&AxiDMA, XPAR_AXI_DMA_0_DEVICE_ID);
    if (status != XST_SUCCESS) {
        printf("DMA initialization failed\n");
        return 1;
    }

    // Timer variables
    XTime PS_start_time, PS_end_time, PL_start_time, PL_end_time;

    // Step 1: Perform FFT on PS side
    XTime_SetTime(0);
    XTime_GetTime(&PS_start_time);

    // Perform FFT on PS
    fft(x);

    XTime_GetTime(&PS_end_time);
    float PS_time = (float)(PS_end_time - PS_start_time) / (COUNTS_PER_SECOND / 1000000);
    printf("\nPS FFT Execution time (in microseconds): %f\n", PS_time);

    // Step 2: Perform PL-side FFT (DMA transfer simulation)
    XTime_SetTime(0);
    XTime_GetTime(&PL_start_time);

    // Transfer to PL and get FFT results (PL-side computation here is assumed to be done by hardware)
    status = XAxiDma_SimpleTransfer(&AxiDMA, (UINTPTR)x_pl, sizeof(Complex) * N, XAXIDMA_DEVICE_TO_DMA);
    if (status != XST_SUCCESS) {
        printf("DMA transfer to device failed\n");
        return 1;
    }
    status = XAxiDma_SimpleTransfer(&AxiDMA, (UINTPTR)x, sizeof(Complex) * N, XAXIDMA_DMA_TO_DEVICE);
    if (status != XST_SUCCESS) {
        printf("DMA transfer from device failed\n");
        return 1;
    }

    // Wait for completion
    while (XAxiDma_Busy(&AxiDMA, XAXIDMA_DMA_TO_DEVICE));
    while (XAxiDma_Busy(&AxiDMA, XAXIDMA_DEVICE_TO_DMA));

    XTime_GetTime(&PL_end_time);
    float PL_time = (float)(PL_end_time - PL_start_time) / (COUNTS_PER_SECOND / 1000000);
    printf("\nPL FFT Execution time (in microseconds): %f\n", PL_time);

    // Step 3: Compare outputs of PS and PL
    printf("\nComparing PS and PL FFT Outputs:\n");
    for (int i = 0; i < N; i++) {
        printf("Index %d: PS Output = %.5f + %.5fi | PL Output = %.5f + %.5fi\n", i, x[i].real, x[i].imag, x_pl[i].real, x_pl[i].imag);
        if (fabs(x[i].real - x_pl[i].real) < 1e-5 && fabs(x[i].imag - x_pl[i].imag) < 1e-5) {
            printf("Transfer Successful!\n");
        } else {
            printf("Mismatch at index %d\n", i);
        }
    }

    return 0;
}
