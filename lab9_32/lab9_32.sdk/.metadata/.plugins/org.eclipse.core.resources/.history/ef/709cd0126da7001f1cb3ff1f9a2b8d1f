#include <stdio.h>
#include <math.h>
#include "platform.h"
#include "xil_printf.h"
#include <xtime_l.h>
#include "xparameters.h"
#include "xaxidma.h"
#include "dma_init.h"

#define N 32 // 32-point FFT
#define PI 3.14159265358979323846

typedef struct {
    double real;
    double imag;
} Complex;

void fft(Complex *x) {
    unsigned int i, j, k, m;
    unsigned int n = N;
    unsigned int a, b;
    Complex temp, W, U;
    int logN = log2(N);

    // Bit reversal (reordering the input array)
    for (i = 1, j = 0; i < n; i++) {
        unsigned int bit = n >> 1;
        while (j >= bit) {
            j -= bit;
            bit >>= 1;
        }
        j += bit;

        if (i < j) {
            // Swap the values
            temp = x[i];
            x[i] = x[j];
            x[j] = temp;
        }
    }

    // FFT computation
    for (i = 1; i <= logN; i++) {
        m = 1 << i;  // m = 2, 4, 8, ..., N
        for (k = 0; k < n; k += m) {
            for (j = 0; j < m / 2; j++) {
                W.real = cos(-2 * PI * j / m);
                W.imag = sin(-2 * PI * j / m);

                a = k + j;
                b = k + j + m / 2;

                // Multiply W with x[b]
                temp.real = W.real * x[b].real - W.imag * x[b].imag;
                temp.imag = W.real * x[b].imag + W.imag * x[b].real;

                // Butterfly operation
                x[b].real = x[a].real - temp.real;
                x[b].imag = x[a].imag - temp.imag;

                x[a].real += temp.real;
                x[a].imag += temp.imag;
            }
        }
    }
}

int main() {
    init_platform();

    // Timer instances for PS and PL
    XTime PL_start_time, PL_end_time;
    XTime PS_start_time, PS_end_time;

    // Buffers
    Complex FFT_input[N] = {
        {11, 23}, {32, 10}, {91, 94}, {15, 69}, {47, 96}, {44, 12}, {96, 17}, {49, 58},
        {8, 16}, {20, 13}, {72, 67}, {34, 18}, {99, 44}, {37, 56}, {80, 24}, {60, 70},
        {10, 30}, {23, 45}, {65, 33}, {19, 74}, {50, 26}, {71, 55}, {89, 41}, {28, 63},
        {7, 22}, {41, 36}, {93, 62}, {48, 12}, {55, 77}, {37, 11}, {22, 84}, {39, 47}
    };
    Complex FFT_output_sw[N], FFT_output_hw[N];

    // Copy the input for software processing
    for (int i = 0; i < N; i++) {
        FFT_output_sw[i] = FFT_input[i];
    }

    // Software FFT Execution
    XTime_SetTime(0);
    XTime_GetTime(&PS_start_time);
    fft(FFT_output_sw);  // Call the provided FFT function
    XTime_GetTime(&PS_end_time);

    // Hardware FFT Execution (PL)
    int status;
    XAxiDma AxiDMA;
    status = DMA_Init(&AxiDMA, XPAR_AXI_DMA_0_DEVICE_ID);
    if (status) return 1;

    XTime_SetTime(0);
    XTime_GetTime(&PL_start_time);
    status = XAxiDma_SimpleTransfer(&AxiDMA, (UINTPTR)FFT_output_hw, sizeof(Complex) * N, XAXIDMA_DEVICE_TO_DMA);
    status = XAxiDma_SimpleTransfer(&AxiDMA, (UINTPTR)FFT_input, sizeof(Complex) * N, XAXIDMA_DMA_TO_DEVICE);
    while (XAxiDma_Busy(&AxiDMA, XAXIDMA_DMA_TO_DEVICE));
    while (XAxiDma_Busy(&AxiDMA, XAXIDMA_DEVICE_TO_DMA));
    XTime_GetTime(&PL_end_time);

    // Print Results
    printf("\n\r------- PS and PL Outputs Comparison --------\n\r");
    for (int i = 0; i < N; i++) {
        printf("Index %d: PS Output = %.5f + %.5fi, PL Output = %.5f + %.5fi\n\r",
               i, FFT_output_sw[i].real, FFT_output_sw[i].imag,
               FFT_output_hw[i].real, FFT_output_hw[i].imag);
    }

    // Execution time
    printf("\n\r------- Execution Time Comparison --------\n\r");
    float time = (float)(PS_end_time - PS_start_time) / (COUNTS_PER_SECOND / 1000000);
    printf("Execution time for PS in Micro-seconds: %f\n\r", time);

    time = (float)(PL_end_time - PL_start_time) / (COUNTS_PER_SECOND / 1000000);
    printf("Execution time for PL in Micro-seconds: %f\n\r", time);

    return 0;
}
