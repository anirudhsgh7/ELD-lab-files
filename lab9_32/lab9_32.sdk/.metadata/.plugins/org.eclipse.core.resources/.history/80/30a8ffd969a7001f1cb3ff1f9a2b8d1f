#include <stdio.h>
#include <math.h>
#include "platform.h"

#define PI 3.14159265358979323846
#define N 8

typedef struct {
    float real;
    float imag;
} Complex;

// Add two complex numbers
Complex complex_add(Complex a, Complex b) {
    Complex result;
    result.real = a.real + b.real;
    result.imag = a.imag + b.imag;
    return result;
}

// Subtract two complex numbers
Complex complex_sub(Complex a, Complex b) {
    Complex result;
    result.real = a.real - b.real;
    result.imag = a.imag - b.imag;
    return result;
}

// Multiply two complex numbers
Complex complex_mul(Complex a, Complex b) {
    Complex result;
    result.real = a.real * b.real - a.imag * b.imag;
    result.imag = a.real * b.imag + a.imag * b.real;
    return result;
}

// Generate the twiddle factors for FFT
void compute_twiddle_factors(Complex twiddles[], int n) {
    for (int i = 0; i < n / 2; i++) {
        twiddles[i].real = cos(-2 * PI * i / n);
        twiddles[i].imag = sin(-2 * PI * i / n);
    }
}

// Perform bit-reversal reordering
void bit_reversal(Complex input[], Complex output[], int n) {
    int log2n = log2(n);
    for (int i = 0; i < n; i++) {
        int reversed = 0;
        for (int j = 0; j < log2n; j++) {
            if (i & (1 << j)) {
                reversed |= (1 << (log2n - 1 - j));
            }
        }
        output[reversed] = input[i];
    }
}

// Perform FFT using the radix-2 Cooley-Tukey algorithm
void FFT_radix2(Complex input[], Complex output[], int n) {
    Complex temp[N];
    Complex twiddles[N / 2];
    compute_twiddle_factors(twiddles, n);

    // Step 1: Bit-reversal reordering
    bit_reversal(input, temp, n);

    // Step 2: Iterative computation
    for (int stage = 1; stage <= log2(n); stage++) {
        int step = 1 << stage;      // Stage size
        int half_step = step >> 1; // Half of the stage size

        for (int group = 0; group < n; group += step) {
            for (int pair = 0; pair < half_step; pair++) {
                Complex twiddle = twiddles[pair * (n / step)];
                Complex t = complex_mul(temp[group + pair + half_step], twiddle);
                Complex u = temp[group + pair];
                temp[group + pair] = complex_add(u, t);
                temp[group + pair + half_step] = complex_sub(u, t);
            }
        }
    }

    // Copy the result
    for (int i = 0; i < n; i++) {
        output[i] = temp[i];
    }
}

int main() {
    init_platform();

    // Input data
    Complex FFT_input[N] = {
        {11, 23}, {32, 10}, {91, 94}, {15, 69},
        {47, 96}, {44, 12}, {96, 17}, {49, 58}
    };
    Complex FFT_output[N];

    // Perform FFT
    FFT_radix2(FFT_input, FFT_output, N);

    // Print results
    printf("\n\r------- 8-Point FFT Output --------\n\r");
    for (int i = 0; i < N; i++) {
        printf("Index %d: %f + %fI\n\r", i, FFT_output[i].real, FFT_output[i].imag);
    }

    return 0;
}
