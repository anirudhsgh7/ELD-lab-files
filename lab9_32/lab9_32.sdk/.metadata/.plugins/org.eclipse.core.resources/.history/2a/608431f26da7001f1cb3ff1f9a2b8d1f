#include <stdio.h>
#include <xparameters.h>
#include <xaxidma.h>
#include <xtime_l.h>

#define N 32 // FFT size

// Complex number structure
typedef struct {
    float real;
    float imag;
} Complex;

// DMA Initialization
int DMA_Init(XAxiDma *AxiDMA, u16 DeviceId) {
    XAxiDma_Config *Config = XAxiDma_LookupConfig(DeviceId);
    if (!Config) {
        printf("No configuration found for %d\n", DeviceId);
        return XST_FAILURE;
    }

    int status = XAxiDma_CfgInitialize(AxiDMA, Config);
    if (status != XST_SUCCESS) {
        printf("Initialization failed %d\n", status);
        return XST_FAILURE;
    }

    // Ensure DMA is in simple mode
    if (!XAxiDma_HasSg(AxiDMA)) {
        return XST_SUCCESS;
    } else {
        printf("Device is in scatter-gather mode\n");
        return XST_FAILURE;
    }
}

int main() {
    // Buffers
    Complex FFT_input[N] = {
        {11, 23}, {32, 10}, {91, 94}, {15, 69}, {47, 96}, {44, 12}, {96, 17}, {49, 58},
        {8, 16}, {20, 13}, {72, 67}, {34, 18}, {99, 44}, {37, 56}, {80, 24}, {60, 70},
        {10, 30}, {23, 45}, {65, 33}, {19, 74}, {50, 26}, {71, 55}, {89, 41}, {28, 63},
        {7, 22}, {41, 36}, {93, 62}, {48, 12}, {55, 77}, {37, 11}, {22, 84}, {39, 47}
    };
    Complex FFT_output_hw[N];

    XAxiDma AxiDMA;
    int status;

    // Initialize the DMA
    status = DMA_Init(&AxiDMA, XPAR_AXI_DMA_0_DEVICE_ID);
    if (status != XST_SUCCESS) {
        printf("DMA initialization failed\n");
        return 1;
    }

    // Timer variables
    XTime PL_start_time, PL_end_time;

    // Perform PL FFT
    XTime_SetTime(0);
    XTime_GetTime(&PL_start_time);

    // Start DMA transfers
    status = XAxiDma_SimpleTransfer(&AxiDMA, (UINTPTR)FFT_output_hw, sizeof(Complex) * N, XAXIDMA_DEVICE_TO_DMA);
    if (status != XST_SUCCESS) {
        printf("DMA transfer to device failed\n");
        return 1;
    }
    status = XAxiDma_SimpleTransfer(&AxiDMA, (UINTPTR)FFT_input, sizeof(Complex) * N, XAXIDMA_DMA_TO_DEVICE);
    if (status != XST_SUCCESS) {
        printf("DMA transfer from device failed\n");
        return 1;
    }

    // Wait for completion
    while (XAxiDma_Busy(&AxiDMA, XAXIDMA_DMA_TO_DEVICE));
    while (XAxiDma_Busy(&AxiDMA, XAXIDMA_DEVICE_TO_DMA));

    XTime_GetTime(&PL_end_time);

    // Print PL FFT outputs
    printf("\n\r------- PL Outputs --------\n\r");
    for (int i = 0; i < N; i++) {
        printf("Index %d: PL Output = %f + %fI\n\r", i, FFT_output_hw[i].real, FFT_output_hw[i].imag);
    }

    // Print execution time
    float time = (float)(PL_end_time - PL_start_time) / (COUNTS_PER_SECOND / 1000000);
    printf("Execution time for PL in Micro-seconds: %f\n\r", time);

    return 0;
}
