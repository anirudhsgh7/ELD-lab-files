// Bit-Reversal Reordering
void bitreverse(float complex dataIn[N], float complex dataOut[N]) {
    for (int i = 0; i < N; i++) {
        dataOut[i] = dataIn[rev32[i]];
    }
}

// FFT Stages (in-place Cooley-Tukey FFT)
// FFT Stages (in-place Cooley-Tukey FFT)
void FFT_stages(float complex FFT_input[N], float complex FFT_output[N], const float complex W[N / 2]) {
    float complex temp[N]; // Temporary storage for intermediate results
    int stage, subFFTSize, BFWidth;

    // Copy input data to temp for in-place computation
    for (int i = 0; i < N; i++) {
        temp[i] = FFT_input[i];
    }

    // Perform FFT stages
    for (stage = 1; stage <= log2(N); stage++) {
        subFFTSize = 1 << stage;          // Sub-FFT size (2^stage)
        BFWidth = subFFTSize >> 1;        // Butterfly width = subFFTSize / 2

        for (int j = 0; j < BFWidth; j++) { // Loop over each butterfly
            float complex twiddle = W[j * (N / subFFTSize)];

            for (int i = j; i < N; i += subFFTSize) {
                int i_lower = i + BFWidth; // Index of the lower point
                float complex tempVal = temp[i_lower] * twiddle;

                // Butterfly operation
                temp[i_lower] = temp[i] - tempVal;
                temp[i] = temp[i] + tempVal;
            }
        }
    }

    // Copy final results to output
    for (int i = 0; i < N; i++) {
        FFT_output[i] = temp[i];
    }
}



// Print Twiddle Factors
