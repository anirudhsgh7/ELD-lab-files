#include <stdio.h>
#include <stdlib.h>
#include "platform.h"
#include "xil_printf.h"
#include <complex.h>
#include <xtime_l.h>
#include "xparameters.h"
#include "xaxidma.h"
#include "dma_init.h"

#define N 8
const int rev8[N] = {0, 4, 2, 6, 1, 5, 3, 7};
const float complex W[N / 2] = {1 + 0 * I, 0.707 - 0.707 * I, 0 - 1 * I, -0.707 - 0.707 * I};

// Function to perform bit reversal
void bitreverse(float complex dataIn[N], float complex dataOut[N])
{
    for (int i = 0; i < N; i++)
    {
        dataOut[i] = dataIn[rev8[i]];
    }
}

// Function to perform FFT stages
void FFT_stages(float complex FFT_input[N], float complex FFT_output[N])
{
    float complex temp1[N], temp2[N];

    // Stage 1
    for (int i = 0; i < N; i += 2)
    {
        temp1[i] = FFT_input[i] + W[0] * FFT_input[i + 1];
        temp1[i + 1] = FFT_input[i] - W[0] * FFT_input[i + 1];
    }

    // Stage 2
    for (int i = 0; i < N; i += 4)
    {
        temp2[i] = temp1[i] + W[0] * temp1[i + 2];
        temp2[i + 1] = temp1[i + 1] + W[2] * temp1[i + 3];
        temp2[i + 2] = temp1[i] - W[0] * temp1[i + 2];
        temp2[i + 3] = temp1[i + 1] - W[2] * temp1[i + 3];
    }

    // Stage 3
    FFT_output[0] = temp2[0] + W[0] * temp2[4];
    FFT_output[1] = temp2[1] + W[1] * temp2[5];
    FFT_output[2] = temp2[2] + W[2] * temp2[6];
    FFT_output[3] = temp2[3] + W[3] * temp2[7];
    FFT_output[4] = temp2[0] - W[0] * temp2[4];
    FFT_output[5] = temp2[1] - W[1] * temp2[5];
    FFT_output[6] = temp2[2] - W[2] * temp2[6];
    FFT_output[7] = temp2[3] - W[3] * temp2[7];
}

// Fixed reciprocal function
void recp(float complex FFT_input[N], float complex FFT_output[N])
{
    for (int i = 0; i < N; i++)
    {
        float real_part = creal(FFT_input[i]);
        float imag_part = cimagf(FFT_input[i]);
        float magnitude_squared = real_part * real_part + imag_part * imag_part;

        // Handle cases where magnitude is close to zero
        if (magnitude_squared < 1e-6)
        {
            FFT_output[i] = 0 + 0 * I; // Set to zero for invalid reciprocal
        }
        else
        {
            FFT_output[i] = (real_part / magnitude_squared) - I * (imag_part / magnitude_squared);
        }
    }
}

int main()
{
    init_platform();

    // FFT input
    float complex FFT_input[N];
    for (int i = 0; i < N; i++)
    {
        FFT_input[i] = i + 1.0 + (i + 1.0) * I;
    }

    // Buffers for output
    float complex FFT_output_sw[N], FFT_output_hw[N];
    float complex FFT_rev_sw[N];
    float complex FFT_input_recp_sw[N];

    XTime PS_start_time, PS_end_time;
    XTime PL_start_time, PL_end_time;

    //////////// Hardware (PL) 8-point FFT
    int status;
    XAxiDma AxiDMA;
    status = DMA_Init(&AxiDMA, XPAR_AXI_DMA_0_DEVICE_ID);
    if (status)
        return 1; // DMA Init failed

    XTime_SetTime(0);
    XTime_GetTime(&PL_start_time);

    // Perform DMA transfers
    status = XAxiDma_SimpleTransfer(&AxiDMA, (UINTPTR)FFT_output_hw, (sizeof(float complex)) * N, XAXIDMA_DEVICE_TO_DMA);
    status = XAxiDma_SimpleTransfer(&AxiDMA, (UINTPTR)FFT_input, (sizeof(float complex)) * N, XAXIDMA_DMA_TO_DEVICE);

    // Wait for transfers to complete
    while (XAxiDma_Busy(&AxiDMA, XAXIDMA_DMA_TO_DEVICE));
    while (XAxiDma_Busy(&AxiDMA, XAXIDMA_DEVICE_TO_DMA));

    XTime_GetTime(&PL_end_time);

    ///////////// Software (PS) 8-point FFT
    XTime_SetTime(0);
    XTime_GetTime(&PS_start_time);

    bitreverse(FFT_input, FFT_rev_sw);
    FFT_stages(FFT_rev_sw, FFT_input_recp_sw);
    recp(FFT_input_recp_sw, FFT_output_sw);

    XTime_GetTime(&PS_end_time);

    ////////////////////// Verifying Results and Comparison
    for (int i = 0; i < N; i++)
    {
        printf("\nIndex %d:", i);
        printf("\nPS Output: %f + %fI", crealf(FFT_output_sw[i]), cimagf(FFT_output_sw[i]));
        printf("\nPL Output: %f + %fI", crealf(FFT_output_hw[i]), cimagf(FFT_output_hw[i]));

        float diff1 = fabsf(crealf(FFT_output_sw[i]) - crealf(FFT_output_hw[i]));
        float diff2 = fabsf(cimagf(FFT_output_sw[i]) - cimagf(FFT_output_hw[i]));

        if (diff1 >= 0.0001 || diff2 >= 0.0001)
        {
            printf("\nData mismatch found at index %d!", i);
        }
        else
        {
            printf("\nOutputs match at index %d!", i);
        }
    }

    /////////////// Execution Time Calculation
    float ps_time = (float)(PS_end_time - PS_start_time) / (COUNTS_PER_SECOND / 1000000);
    float pl_time = (float)(PL_end_time - PL_start_time) / (COUNTS_PER_SECOND / 1000000);

    printf("\n\nExecution time for PS (software) in microseconds: %f", ps_time);
    printf("\nExecution time for PL (hardware) in microseconds: %f", pl_time);

    cleanup_platform();
    return 0;
}
