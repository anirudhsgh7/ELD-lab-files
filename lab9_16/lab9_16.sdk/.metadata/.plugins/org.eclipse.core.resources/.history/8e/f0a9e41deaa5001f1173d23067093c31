#include <stdio.h>
#include <stdlib.h>
#include <xtime_l.h>

#define N 4

// Custom Complex Number Struct
typedef struct {
    float real;
    float imag;
} Complex;

// Helper Functions for Complex Arithmetic
Complex add(Complex a, Complex b) {
    return (Complex){a.real + b.real, a.imag + b.imag};
}

Complex subtract(Complex a, Complex b) {
    return (Complex){a.real - b.real, a.imag - b.imag};
}

Complex multiply(Complex a, Complex b) {
    return (Complex){
        a.real * b.real - a.imag * b.imag,
        a.real * b.imag + a.imag * b.real
    };
}

const int rev4[N] = {0, 2, 1, 3};
const Complex W[N / 2] = {
    {1.0, 0.0},  // W[0] = 1 + 0i
    {0.0, -1.0}  // W[1] = 0 - 1i
};

// Function to perform bit-reversal
void bitreverse(Complex dataIn[N], Complex dataOut[N]) {
    for (int i = 0; i < N; i++) {
        dataOut[i] = dataIn[rev4[i]];
    }
}

// Function to perform FFT stages
void FFT_stages(Complex FFT_input[N], Complex FFT_output[N]) {
    Complex temp1[N];

    // Stage 1
    for (int i = 0; i < N; i += 2) {
        temp1[i] = add(FFT_input[i], FFT_input[i + 1]);
        temp1[i + 1] = subtract(FFT_input[i], FFT_input[i + 1]);
    }

    // Stage 2
    for (int i = 0; i < N / 2; i++) {
        FFT_output[i] = add(temp1[i], multiply(W[i], temp1[i + 2]));
        FFT_output[i + 2] = subtract(temp1[i], multiply(W[i], temp1[i + 2]));
    }
}

int main() {
    // Input data
    const Complex FFT_input[N] = {
        {11, 23},
        {32, 10},
        {91, 94},
        {15, 69}
    };
    Complex FFT_output[N];
    Complex FFT_rev[N];
    Complex FFT_output_sw[N];
    Complex FFT_rev_sw[N];

    // Perform bit-reversal and FFT
    bitreverse(FFT_input, FFT_rev);
    FFT_stages(FFT_rev, FFT_output);

    // Print FFT input
    printf("\nPrinted FFT input\n");
    for (int i = 0; i < N; i++) {
        printf("Real: %f Imag: %f\n", FFT_input[i].real, FFT_input[i].imag);
    }

    // Print FFT output
    printf("\nPrinted FFT output\n");
    for (int i = 0; i < N; i++) {
        printf("Real: %f Imag: %f\n", FFT_output[i].real, FFT_output[i].imag);
    }

    // Timing variables
    XTime PS_start_time, PS_end_time;

    // Measure execution time
    XTime_SetTime(0); // Reset Timer
    XTime_GetTime(&PS_start_time); // Get Start Time

    // Software bit-reversal and FFT for timing
    bitreverse(FFT_input, FFT_rev_sw);
    FFT_stages(FFT_rev_sw, FFT_output_sw);

    XTime_GetTime(&PS_end_time); // Get End Time

    // Print counts per second for debug
    printf("\nCOUNTS_PER_SECOND: %llu\n", COUNTS_PER_SECOND);

    // Calculate execution time in microseconds
    float time = (float)(PS_end_time - PS_start_time) / (COUNTS_PER_SECOND / 1000000);
    printf("\nExecution time for PS in Micro-seconds: %f\n", time);

    return 0;
}
