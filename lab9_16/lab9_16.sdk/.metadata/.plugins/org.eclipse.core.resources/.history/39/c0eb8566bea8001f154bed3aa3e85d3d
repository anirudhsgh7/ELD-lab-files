#include <stdio.h>
#include <stdlib.h>
#include <complex.h>
#include "platform.h"
#include "xil_printf.h"
#include <xtime_l.h>
#include "xparameters.h"
#include "xaxidma.h"
#include "dma_init.h"

#define N 16
#define COUNTS_PER_SECOND 333000000 // Adjust based on your clock

const int rev16[N] = {0, 8, 4, 12, 2, 10, 6, 14, 1, 9, 5, 13, 3, 11, 7, 15};
const float complex W[N/2] = {
    1+0*I, 0.924-0.382*I, 0.707-0.707*I, 0.382-0.924*I,
    0-1*I, -0.382-0.924*I, -0.707-0.707*I, -0.924-0.382*I
};

void bitreverse(float complex dataIn[N], float complex dataOut[N]) {
    for (int i = 0; i < N; i++) {
        dataOut[i] = dataIn[rev16[i]];
    }
}

void FFT_stages(float complex FFT_input[N], float complex FFT_output[N]) {
    float complex temp1[N], temp2[N], temp3[N];

    // Stage 1
    for (int i = 0; i < N; i += 2) {
        temp1[i] = FFT_input[i] + W[0] * FFT_input[i + 1];
        temp1[i + 1] = FFT_input[i] - W[0] * FFT_input[i + 1];
    }

    // Stage 2
    for (int i = 0; i < N; i += 4) {
        temp2[i] = temp1[i] + W[0] * temp1[i + 2];
        temp2[i + 1] = temp1[i + 1] + W[4] * temp1[i + 3];
        temp2[i + 2] = temp1[i] - W[0] * temp1[i + 2];
        temp2[i + 3] = temp1[i + 1] - W[4] * temp1[i + 3];
    }

    // Stage 3
    for (int i = 0; i < N; i += 8) {
        temp3[i] = temp2[i] + W[0] * temp2[i + 4];
        temp3[i + 1] = temp2[i + 1] + W[2] * temp2[i + 5];
        temp3[i + 2] = temp2[i + 2] + W[4] * temp2[i + 6];
        temp3[i + 3] = temp2[i + 3] + W[6] * temp2[i + 7];
        temp3[i + 4] = temp2[i] - W[0] * temp2[i + 4];
        temp3[i + 5] = temp2[i + 1] - W[2] * temp2[i + 5];
        temp3[i + 6] = temp2[i + 2] - W[4] * temp2[i + 6];
        temp3[i + 7] = temp2[i + 3] - W[6] * temp2[i + 7];
    }

    // Stage 4
    for (int i = 0; i < N / 2; i++) {
        FFT_output[i] = temp3[i] + W[i] * temp3[i + 8];
        FFT_output[i + 8] = temp3[i] - W[i] * temp3[i + 8];
    }
}

int main() {
    init_platform();

    XTime PS_start_time, PS_end_time;
    XTime PL_start_time, PL_end_time;

    float complex FFT_input[N] = {
        1.0 + 0.0*I, 1.0 + 1.0*I, 2.0 + 0.0*I, 2.0 + 2.0*I,
        3.0 + 0.0*I, 3.0 + 3.0*I, 4.0 + 0.0*I, 4.0 + 4.0*I,
        5.0 + 0.0*I, 5.0 + 5.0*I, 6.0 + 0.0*I, 6.0 + 6.0*I,
        7.0 + 0.0*I, 7.0 + 7.0*I, 8.0 + 0.0*I, 8.0 + 8.0*I
    };

    float complex FFT_output_sw[N], FFT_output_hw[N];
    float complex FFT_rev_sw[N];

    // DMA initialization
    XAxiDma AxiDMA;
    int status = DMA_Init(&AxiDMA, XPAR_AXI_DMA_0_DEVICE_ID);
    if (status) return 1;

    // Hardware FFT
    XTime_GetTime(&PL_start_time);
    XAxiDma_SimpleTransfer(&AxiDMA, (UINTPTR)FFT_output_hw, sizeof(float complex) * N, XAXIDMA_DEVICE_TO_DMA);
    XAxiDma_SimpleTransfer(&AxiDMA, (UINTPTR)FFT_input, sizeof(float complex) * N, XAXIDMA_DMA_TO_DEVICE);
    while (XAxiDma_Busy(&AxiDMA, XAXIDMA_DMA_TO_DEVICE));
    while (XAxiDma_Busy(&AxiDMA, XAXIDMA_DEVICE_TO_DMA));
    XTime_GetTime(&PL_end_time);

    // Software FFT
    XTime_GetTime(&PS_start_time);
    bitreverse(FFT_input, FFT_rev_sw);
    FFT_stages(FFT_rev_sw, FFT_output_sw);
    XTime_GetTime(&PS_end_time);

    // Compare Results
    for (int i = 0; i < N; i++) {
        printf("PS: %f + %fI, PL: %f + %fI\n", crealf(FFT_output_sw[i]), cimagf(FFT_output_sw[i]), crealf(FFT_output_hw[i]), cimagf(FFT_output_hw[i]));
    }

    // Execution Time
    printf("PS Time: %f us, PL Time: %f us\n",
           1.0 * (PS_end_time - PS_start_time) / (COUNTS_PER_SECOND / 1000000),
           1.0 * (PL_end_time - PL_start_time) / (COUNTS_PER_SECOND / 1000000));

    cleanup_platform();
    return 0;
}
